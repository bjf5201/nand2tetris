// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */

CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    // choose if a or b based on 2^0 place of sel
    Mux16(a=a, b=b, sel=sel[0], out=abOut);

    // choose if c or d based on 2^0 place of sel
    Mux16(a=c, b=d, sel=sel[0], out=cdOut);

    // choose if a/b output or c/d output based on 2^1 place of sel
    Mux16(a=abOut, b=cdOut, sel=sel[1], out=out);
    
}