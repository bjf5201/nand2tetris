// File name: projects/03/b/RAM4K.hdl
/**
 * Memory of 4K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:
    // Use demultiplexer (8-way) to select register to pass input to using 3 left MSBs (most-significant bits)
    DMux8Way(in=load, sel=address[9..11], a=load000, b=load001, c=load010,
    d=load011, e=load100, f=load101, g=load110, h=load111);

    // Assign demultiplexer output to appropriate address within register, using the 9 right LSBs (least-significant bits)
    RAM512(in=in, load=load000, address=address[0..8], out=out000);
    RAM512(in=in, load=load001, address=address[0..8], out=out001);
    RAM512(in=in, load=load010, address=address[0..8], out=out010);
    RAM512(in=in, load=load011, address=address[0..8], out=out011);
    RAM512(in=in, load=load100, address=address[0..8], out=out100);
    RAM512(in=in, load=load101, address=address[0..8], out=out101);
    RAM512(in=in, load=load110, address=address[0..8], out=out110);
    RAM512(in=in, load=load111, address=address[0..8], out=out111);

    // Use multiplexer (8-way) to select address output to read from
    Mux8Way16(a=out000, b=out001, c=out010,
    d=out011, e=out100, f=out101, g=out110, h=out111, sel=address[9..11], out=out);
 }